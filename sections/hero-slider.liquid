{%- liquid
  assign s = section.settings
  assign sid = section.id
-%}

<style>
  #hs-{{ sid }} {
    --hs-ratio-desktop: {{ s.ratio_desktop }};
    --hs-ratio-mobile: {{ s.ratio_mobile }};
    --hs-arrow-bg: {{ s.arrow_bg }};
    --hs-arrow-ink: {{ s.arrow_ink }};
    --hs-dot: {{ s.dot_color }};
    --hs-gap: {{ s.gap }}px;
    position: relative;
    margin: 0 auto;
    {% if s.full_width %}max-width: 100%;{% else %}max-width: {{ s.max_width }}px;{% endif %}
    padding: {{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
    background: {{ s.section_bg }};
  }
  #hs-{{ sid }} .hs__viewport {
    position: relative;
    overflow: hidden;
    {% unless s.full_width %}border-radius: {{ s.radius }}px;{% endunless %}
  }
  #hs-{{ sid }} .hs__track {
    display: flex;
    gap: var(--hs-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  #hs-{{ sid }} .hs__track::-webkit-scrollbar { display: none; }
  #hs-{{ sid }} .hs__slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: block;
    aspect-ratio: var(--hs-ratio-desktop);
    background: {{ s.slide_bg }};
    overflow: hidden;
  }
  #hs-{{ sid }} .hs__media,
  #hs-{{ sid }} .hs__media img,
  #hs-{{ sid }} .hs__media svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  #hs-{{ sid }} .hs__media--mobile { display: none; }

  /* Capa de texto opcional sobre la imagen */
  #hs-{{ sid }} .hs__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 35%, rgba(0,0,0,{{ s.scrim_opacity | divided_by: 100.0 }}) 100%);
    pointer-events: none;
  }
  #hs-{{ sid }} .hs__content {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    justify-items: {{ s.text_align }};
    text-align: {{ s.text_align }};
    gap: 12px;
    padding: clamp(20px, 5vw, 64px);
    color: #fff;
  }
  #hs-{{ sid }} .hs__eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.9;
  }
  #hs-{{ sid }} .hs__heading {
    margin: 0;
    font-size: clamp(28px, 5vw, 64px);
    line-height: 1.02;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  #hs-{{ sid }} .hs__sub {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(15px, 1.4vw, 19px);
    opacity: 0.92;
  }
  #hs-{{ sid }} .hs__btn {
    display: inline-block;
    margin-top: 6px;
    padding: 14px 26px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    background: {{ s.btn_bg }};
    color: {{ s.btn_ink }};
    transition: transform .15s ease, opacity .15s ease;
  }
  #hs-{{ sid }} .hs__btn:hover { transform: translateY(-1px); opacity: .92; }

  /* Flechas */
  #hs-{{ sid }} .hs__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    background: var(--hs-arrow-bg);
    color: var(--hs-arrow-ink);
    transition: opacity .15s ease, transform .15s ease;
  }
  #hs-{{ sid }} .hs__arrow:hover { transform: translateY(-50%) scale(1.06); }
  #hs-{{ sid }} .hs__arrow[hidden] { display: none; }
  #hs-{{ sid }} .hs__arrow--prev { left: 14px; }
  #hs-{{ sid }} .hs__arrow--next { right: 14px; }
  #hs-{{ sid }} .hs__arrow svg { width: 20px; height: 20px; }

  /* Puntos */
  #hs-{{ sid }} .hs__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 14px;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  #hs-{{ sid }} .hs__dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    background: var(--hs-dot);
    opacity: .45;
    transition: opacity .2s ease, width .2s ease;
  }
  #hs-{{ sid }} .hs__dot[aria-current="true"] { opacity: 1; width: 26px; }

  #hs-{{ sid }} .hs__arrow:focus-visible,
  #hs-{{ sid }} .hs__dot:focus-visible,
  #hs-{{ sid }} .hs__slide:focus-visible {
    outline: 3px solid {{ s.dot_color }};
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    #hs-{{ sid }} .hs__slide { aspect-ratio: var(--hs-ratio-mobile); }
    {% if s.mobile_hide_arrows %}#hs-{{ sid }} .hs__arrow { display: none; }{% endif %}
    #hs-{{ sid }} .hs__media--desktop { display: none; }
    #hs-{{ sid }} .hs__media--mobile { display: block; }
    #hs-{{ sid }} .hs__media--only-desktop { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    #hs-{{ sid }} .hs__track { scroll-behavior: auto; }
  }
</style>

<div
  id="hs-{{ sid }}"
  class="hs"
  data-hero-slider
  data-autoplay="{{ s.autoplay }}"
  data-interval="{{ s.interval | times: 1000 }}"
  aria-roledescription="carrusel"
  aria-label="{{ s.aria_label | escape }}"
>
  <div class="hs__viewport">
    <div class="hs__track" data-track tabindex="0" aria-live="polite">
      {%- for block in section.blocks -%}
        {%- liquid
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
          assign tag = 'div'
          if has_link
            assign tag = 'a'
          endif
          assign loading = 'lazy'
          assign priority = 'auto'
          if forloop.first
            assign loading = 'eager'
            assign priority = 'high'
          endif
        -%}
        <{{ tag }}
          class="hs__slide"
          {% if has_link %}href="{{ block.settings.link }}"{% endif %}
          data-slide
          aria-label="{{ block.settings.heading | default: block.settings.image.alt | default: 'Slide' | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="hs__media hs__media--desktop{% if block.settings.image_mobile == blank %} hs__media--only-desktop{% endif %}">
              {{
                block.settings.image
                | image_url: width: 3000
                | image_tag:
                  widths: '600, 900, 1200, 1600, 2000, 2600, 3000',
                  sizes: '100vw',
                  loading: loading,
                  fetchpriority: priority,
                  alt: block.settings.image.alt | default: block.settings.heading
              }}
            </div>
          {%- else -%}
            <div class="hs__media hs__media--desktop hs__media--only-desktop">
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}

          {%- if block.settings.image_mobile != blank -%}
            <div class="hs__media hs__media--mobile">
              {{
                block.settings.image_mobile
                | image_url: width: 1400
                | image_tag:
                  widths: '400, 600, 800, 1000, 1400',
                  sizes: '100vw',
                  loading: loading,
                  alt: block.settings.image_mobile.alt | default: block.settings.heading
              }}
            </div>
          {%- endif -%}

          {%- if block.settings.show_scrim -%}<div class="hs__scrim"></div>{%- endif -%}

          {%- if block.settings.eyebrow != blank
            or block.settings.heading != blank
            or block.settings.subheading != blank
            or block.settings.btn_text != blank -%}
            <div class="hs__content">
              {%- if block.settings.eyebrow != blank -%}
                <p class="hs__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <p class="hs__heading">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <p class="hs__sub">{{ block.settings.subheading }}</p>
              {%- endif -%}
              {%- if block.settings.btn_text != blank -%}
                <span class="hs__btn">{{ block.settings.btn_text }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      {%- if s.show_arrows -%}
        <button type="button" class="hs__arrow hs__arrow--prev" data-prev aria-label="Anterior">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="hs__arrow hs__arrow--next" data-next aria-label="Siguiente">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {%- endif -%}

      {%- if s.show_dots -%}
        <ul class="hs__dots" data-dots>
          {%- for block in section.blocks -%}
            <li>
              <button
                type="button"
                class="hs__dot"
                data-dot="{{ forloop.index0 }}"
                aria-label="Ir al slide {{ forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              ></button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function initHeroSlider(root) {
      if (!root || root.dataset.hsReady === '1') return;
      root.dataset.hsReady = '1';

      var track = root.querySelector('[data-track]');
      var slides = root.querySelectorAll('[data-slide]');
      var dots = root.querySelectorAll('[data-dot]');
      var prev = root.querySelector('[data-prev]');
      var next = root.querySelector('[data-next]');
      if (!track || slides.length === 0) return;

      var index = 0;
      var timer = null;
      var autoplay = root.dataset.autoplay === 'true' && slides.length > 1;
      var interval = parseInt(root.dataset.interval, 10) || 5000;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function goTo(i) {
        index = (i + slides.length) % slides.length;
        track.scrollTo({ left: slides[index].offsetLeft, behavior: reduced ? 'auto' : 'smooth' });
        sync();
      }

      function sync() {
        for (var d = 0; d < dots.length; d++) {
          if (d === index) dots[d].setAttribute('aria-current', 'true');
          else dots[d].removeAttribute('aria-current');
        }
      }

      function start() {
        if (!autoplay) return;
        stop();
        timer = setInterval(function () {
          if (document.hidden) return;
          goTo(index + 1);
        }, interval);
      }
      function stop() {
        if (timer) clearInterval(timer);
        timer = null;
      }
      function restart() { stop(); start(); }

      if (prev) prev.addEventListener('click', function () { goTo(index - 1); restart(); });
      if (next) next.addEventListener('click', function () { goTo(index + 1); restart(); });

      for (var i = 0; i < dots.length; i++) {
        (function (btn) {
          btn.addEventListener('click', function () {
            goTo(parseInt(btn.dataset.dot, 10));
            restart();
          });
        })(dots[i]);
      }

      // El usuario arrastra o hace swipe: seguimos la posición real
      var scrollTick;
      track.addEventListener('scroll', function () {
        clearTimeout(scrollTick);
        scrollTick = setTimeout(function () {
          var closest = 0;
          var min = Infinity;
          for (var s = 0; s < slides.length; s++) {
            var dist = Math.abs(slides[s].offsetLeft - track.scrollLeft);
            if (dist < min) { min = dist; closest = s; }
          }
          if (closest !== index) { index = closest; sync(); }
        }, 90);
      }, { passive: true });

      track.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); goTo(index + 1); restart(); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(index - 1); restart(); }
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop(); else start();
      });

      window.addEventListener('resize', function () {
        track.scrollTo({ left: slides[index].offsetLeft, behavior: 'auto' });
      });

      start();
    }

    function initAll(scope) {
      (scope || document).querySelectorAll('[data-hero-slider]').forEach(initHeroSlider);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }

    // Editor de temas de Shopify
    document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
    document.addEventListener('shopify:block:select', function (e) {
      var root = e.target.closest('[data-hero-slider]');
      var track = root && root.querySelector('[data-track]');
      if (track) track.scrollTo({ left: e.target.offsetLeft, behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Slider principal",
  "tag": "section",
  "class": "hero-slider-section",
  "settings": [
    { "type": "header", "content": "Comportamiento" },
    { "type": "checkbox", "id": "autoplay", "label": "Pasar solo", "default": true },
    { "type": "range", "id": "interval", "label": "Segundos por slide", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "checkbox", "id": "show_arrows", "label": "Mostrar flechas", "default": true },
    { "type": "checkbox", "id": "mobile_hide_arrows", "label": "Ocultar flechas en móvil", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Mostrar puntos", "default": true },
    { "type": "text", "id": "aria_label", "label": "Nombre para lectores de pantalla", "default": "Ofertas destacadas" },

    { "type": "header", "content": "Tamaño" },
    { "type": "checkbox", "id": "full_width", "label": "Ancho completo de pantalla", "default": true },
    { "type": "range", "id": "max_width", "label": "Ancho máximo si no es completo (px)", "min": 900, "max": 1800, "step": 20, "default": 1400 },
    { "type": "range", "id": "radius", "label": "Redondeo si no es completo (px)", "min": 0, "max": 40, "step": 2, "default": 16 },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "Proporción en ordenador",
      "options": [
        { "value": "21 / 9", "label": "Panorámica (21:9)" },
        { "value": "16 / 9", "label": "Ancha (16:9)" },
        { "value": "2 / 1", "label": "2:1" },
        { "value": "3 / 2", "label": "3:2" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Proporción en móvil",
      "options": [
        { "value": "4 / 5", "label": "Vertical (4:5)" },
        { "value": "1 / 1", "label": "Cuadrada (1:1)" },
        { "value": "3 / 4", "label": "Vertical alta (3:4)" },
        { "value": "16 / 9", "label": "Ancha (16:9)" }
      ],
      "default": "4 / 5"
    },
    { "type": "range", "id": "gap", "label": "Separación entre slides (px)", "min": 0, "max": 24, "step": 2, "default": 0 },
    { "type": "range", "id": "padding_top", "label": "Espacio arriba (px)", "min": 0, "max": 80, "step": 4, "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio abajo (px)", "min": 0, "max": 80, "step": 4, "default": 0 },

    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "section_bg", "label": "Fondo de la sección", "default": "#000000" },
    { "type": "color", "id": "slide_bg", "label": "Fondo mientras carga la imagen", "default": "#111111" },
    { "type": "range", "id": "scrim_opacity", "label": "Oscurecido bajo el texto (%)", "min": 0, "max": 90, "step": 5, "default": 55 },
    { "type": "color", "id": "arrow_bg", "label": "Fondo de las flechas", "default": "#FFFFFF" },
    { "type": "color", "id": "arrow_ink", "label": "Color de las flechas", "default": "#111111" },
    { "type": "color", "id": "dot_color", "label": "Color de los puntos", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_bg", "label": "Fondo del botón", "default": "#FFFFFF" },
    { "type": "color", "id": "btn_ink", "label": "Texto del botón", "default": "#111111" },

    { "type": "header", "content": "Texto" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alineación del texto",
      "options": [
        { "value": "start", "label": "Izquierda" },
        { "value": "center", "label": "Centro" },
        { "value": "end", "label": "Derecha" }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen (ordenador)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagen (móvil, opcional)" },
        { "type": "url", "id": "link", "label": "Enlace del slide" },
        { "type": "header", "content": "Texto sobre la imagen (opcional)" },
        { "type": "checkbox", "id": "show_scrim", "label": "Oscurecer el fondo del texto", "default": true },
        { "type": "text", "id": "eyebrow", "label": "Texto pequeño" },
        { "type": "text", "id": "heading", "label": "Titular" },
        { "type": "text", "id": "subheading", "label": "Subtítulo" },
        { "type": "text", "id": "btn_text", "label": "Texto del botón" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slider principal",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
