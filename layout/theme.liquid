<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>
    {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; página {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="theme-color" content="{{ settings.color_bg }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700;800&family=Public+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

  {{ content_for_header }}

  <style>
    :root{
      --color-bg: {{ settings.color_bg }};
      --color-surface: {{ settings.color_surface }};
      --color-ink: {{ settings.color_ink }};
      --color-ink-soft: {{ settings.color_ink_soft }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-soft: {{ settings.color_accent_soft }};
      --color-cta: {{ settings.color_cta }};
      --color-star: {{ settings.color_star }};
      --color-line: {{ settings.color_line }};
      --font-display: {{ settings.font_display }};
      --font-body: {{ settings.font_body }};
      --page-width: {{ settings.page_width }}px;
      --radius: {{ settings.radius }}px;
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  <script>document.documentElement.classList.remove('no-js');</script>
</head>
<body class="tpl-{{ request.page_type }}">

  <a class="skip-link" href="#main-content">Saltar al contenido</a>

  {% section 'header' %}

  <main id="main-content">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  <div id="cart-toast" class="cart-toast" role="status" aria-live="polite"></div>

  <script>
    window.themeStrings = {
      addedToCart: "Añadido al carrito",
      cartError: "No se ha podido añadir el producto",
      soldOut: "Agotado"
    };
    window.shopMoneyFormat = {{ shop.money_format | json }};
    window.themeRoutes = {
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }},
      cart: {{ routes.cart_url | json }}
    };
  </script>
</body>
</html>
