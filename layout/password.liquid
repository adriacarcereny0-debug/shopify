<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700;800&family=Public+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  {{ content_for_header }}
  <style>
    :root{
      --color-bg: {{ settings.color_bg }};
      --color-surface: {{ settings.color_surface }};
      --color-ink: {{ settings.color_ink }};
      --color-ink-soft: {{ settings.color_ink_soft }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-soft: {{ settings.color_accent_soft }};
      --color-cta: {{ settings.color_cta }};
      --color-star: {{ settings.color_star }};
      --color-line: {{ settings.color_line }};
      --font-display: {{ settings.font_display }};
      --font-body: {{ settings.font_body }};
      --page-width: {{ settings.page_width }}px;
      --radius: {{ settings.radius }}px;
    }
  </style>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="tpl-password">
  <main class="password-screen">
    <div class="password-screen__inner reveal">
      <p class="eyebrow">Próximamente</p>
      {% if settings.logo %}
        <img src="{{ settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" class="password-screen__logo" width="240" height="{{ 240 | divided_by: settings.logo.aspect_ratio | round }}" loading="eager">
      {% else %}
        <h1 class="password-screen__wordmark">{{ shop.name }}</h1>
      {% endif %}
      <p class="password-screen__note">Estamos preparando algo. Deja tu correo y serás de los primeros en saberlo.</p>

      {% form 'customer' %}
        {% if form.posted_successfully? %}
          <p class="password-screen__success">Gracias, te avisaremos.</p>
        {% else %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="password-screen__form">
            <input type="email" name="contact[email]" placeholder="tu@email.com" required aria-label="Correo electrónico">
            <button type="submit" class="btn btn--primary">
              <span>Avísame</span>
              <span class="btn__icon">→</span>
            </button>
          </div>
        {% endif %}
      {% endform %}

      {% if shop.password_message != blank %}
        <div class="password-screen__owner-message">{{ shop.password_message }}</div>
      {% endif %}

      <a class="password-screen__enter" href="{{ routes.root_url }}?password_challenge">¿Tienes la contraseña? Entrar</a>
    </div>
  </main>
</body>
</html>
