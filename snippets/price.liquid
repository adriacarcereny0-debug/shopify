{%- comment -%}
  Renders a price block. Usage: {% render 'price', product: product, variant: variant %}
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
-%}
<span class="price {% if target.compare_at_price > target.price %}price--sale{% endif %}">
  <span class="price__current">{{ target.price | money }}</span>
  {%- if target.compare_at_price > target.price -%}
    <span class="price__compare">{{ target.compare_at_price | money }}</span>
  {%- endif -%}
</span>
