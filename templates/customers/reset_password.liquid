<section class="simple-content account">
  <div class="wrap wrap--narrow">
    <p class="eyebrow">Mi cuenta</p>
    <h1 class="simple-content__heading">Nueva contraseña</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="form-field">
        <label for="reset-password">Contraseña</label>
        <input type="password" id="reset-password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="form-field">
        <label for="reset-password-confirm">Repite la contraseña</label>
        <input type="password" id="reset-password-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--cta"><span>Guardar contraseña</span></button>
    {% endform %}
  </div>
</section>
