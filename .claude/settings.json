{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/graphify-update.py"],
            "async": true,
            "timeout": 120,
            "statusMessage": "Actualizando grafo graphify..."
          }
        ]
      }
    ]
  }
}
